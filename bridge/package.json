{
  "name": "skybound-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:fsuipc": "node src/index.js --fsuipc",
    "start:simconnect": "node src/index.js --simconnect",
    "start:mock": "node src/index.js --mock",
    "proxy": "node proxy.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.0.0",
    "http-proxy": "^1.18.1",
    "node-simconnect": "^3.2.0"
  },
  "optionalDependencies": {
    "fsuipc": "^0.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "node_modules/node-simconnect/prebuilds/**/*",
      "node_modules/node-simconnect/build/Release/*.node"
    ]
  }
}
