{
  "expo": {
    "name": "SkyBound EFB",
    "slug": "skybound-efb",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070b12",
    "scheme": "skybound",
    "ios": {
      "bundleIdentifier": "cx.skybound.efb",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
